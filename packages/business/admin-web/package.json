{
  "name": "@flexboot4/admin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api/*": {
      "types": "./src/api/*.ts",
      "import": "./src/api/*.ts",
      "default": "./src/api/*.ts"
    },
    "./api/devops/*": {
      "types": "./src/api/devops/*.ts",
      "import": "./src/api/devops/*.ts",
      "default": "./src/api/devops/*.ts"
    },
    "./api/system/*": {
      "types": "./src/api/system/*.ts",
      "import": "./src/api/system/*.ts",
      "default": "./src/api/system/*.ts"
    },
    "./utils/*": {
      "types": "./src/utils/*.ts",
      "import": "./src/utils/*.ts",
      "default": "./src/utils/*.ts"
    }
  },
  "dependencies": {
    "@ant-design/icons-vue": "catalog:",
    "@flexboot4/web-kit": "workspace:*",
    "@vben-core/menu-ui": "workspace:*",
    "@vben/access": "workspace:*",
    "@vben/common-ui": "workspace:*",
    "@vben/icons": "workspace:*",
    "@vben/locales": "workspace:*",
    "@vben/plugins": "workspace:*",
    "@vben/types": "workspace:*",
    "@vben/utils": "workspace:*",
    "@vueuse/core": "catalog:",
    "ant-design-vue": "catalog:",
    "dayjs": "catalog:",
    "qrcode": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@vben/tsconfig": "workspace:*"
  }
}
