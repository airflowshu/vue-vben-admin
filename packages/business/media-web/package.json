{
  "name": "@flexboot4/media-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api/*": {
      "types": "./src/api/*.ts",
      "default": "./src/api/*.ts"
    },
    "./api/media/*": {
      "types": "./src/api/media/*.ts",
      "default": "./src/api/media/*.ts"
    }
  },
  "dependencies": {
    "@ant-design/icons-vue": "catalog:",
    "@flexboot4/admin-web": "workspace:*",
    "@flexboot4/web-kit": "workspace:*",
    "@vben/common-ui": "workspace:*",
    "@vben/locales": "workspace:*",
    "@vben/types": "workspace:*",
    "@vben/utils": "workspace:*",
    "ant-design-vue": "catalog:",
    "dayjs": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@vben/tsconfig": "workspace:*"
  }
}
